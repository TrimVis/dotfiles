(defvar amixer "amixer -D pulse")
(defvar temperature-monitor "psensor")

(defwindow bar
  :exclusive true
  :monitor 0
  :windowtype "dock"
  :geometry (geometry
             :x "0%"
             :y "0%"
             :width "100%"
             :height 20
             :anchor "center top")
  
  :reserve (struts :side "top" :distance 20)
  (centerbox
   :orientation "h"
   (box
    :orientation "h" :space-evenly false 
    (label
     :class "launcher"
     :width 40 :height 20
     :unindent true
     :tooltip active-window-title
     :text "")
    (widget-workspaces))
    
   (widget-media) 


    
   (box
    :class "status"
    :orientation "h" :space-evenly false :halign "end"
      :spacing 5
    (widget-volume)
    (widget-microphone)
    (widget-cpu)
    (widget-memory)
    (widget-clock)(widget-tray))))


(defwidget widget-workspaces []
  (box
   :class "workspaces"
   :orientation "h"
   :space-evenly true
   :spacing 10
   :valign "center"
   :halign "start"
   (for workspace in workspaces
    (button
     :class "${workspace.class}"
     :onclick "scripts/compositor-control set-workspace ${workspace.id}"
     "${workspace.text}"))))
    
(deflisten workspaces :initial "[]"
  "scripts/compositor-control workspaces")
(deflisten active-window-title :initial ""
  "scripts/compositor-control active-title")


(defwidget widget-media []
  (box
   :class "media"
   :orientation "h"
   :space-evenly false
   :tooltip "${media-status == 'Paused' ? '' : media-status == 'Playing' ? '' : ''} ${media-position-text}"
   (eventbox
    :onclick "playerctl play-pause"
    (circular-progress
     :class { media-status == "Paused" ? "media-paused" : media-status == "Stopped" ? "media-stopped" : "media-playing"}
     :width 20
     :height 20
     :thickness 5
     :value {100.0 * (media-position?:0) / (media-length / 1000000.0)}
     :visible {media-current != "" && media-status != "Stopped"}))
      
   (label
    :class { media-status == "Paused" ? "media-text-paused" : media-status == "Stopped" ? "media-text-stopped" : "media-text-playing"}
    :angle 0
    :xalign 0.5
    :yalign 0.5
    :justify "center"
    :limit-width 120
    :text "『${media-current}』")))
  


(deflisten media-current :initial ""
  "playerctl --follow metadata --format '{{ artist }} / {{album}} / {{ title }}' || true")
(deflisten media-position-text :initial ""
  "playerctl --follow metadata --format '{{duration(position)}} / {{duration(mpris:length)}}' || true")
(defpoll media-position
  :interval "1s" :run-while {media-current != ""}
  "playerctl position")
(deflisten media-length :initial 1
  "playerctl --follow metadata mpris:length")
(deflisten media-status :initial "Stopped"
  "playerctl --follow status")

(defwidget widget-volume []
  (eventbox
   :onhover "${EWW_CMD} update show-volume=true"
   :onhoverlost "${EWW_CMD} update show-volume=false"
   :onclick "${amixer} sset Master toggle"
   (box
    :class "volume status-item"
    :orientation "h"
    :space-evenly "false"
    :spacing "2"
    :tooltip "Volume: ${current-volume}% [${current-volume-state}]"
    (revealer :transition "slideleft" :reveal show-volume
     (scale
          :class "scale"
          :value current-volume
          :orientation "h"
          :flipped false
          :marks true
          :max 101
          :min 0
          :onchange "${amixer} sset Master {}%"))
    (label
     :class "icon"
     :width 25 :height 20
     :xalign 0.5 :yalign 0.5
     :text { current-volume-state == "off" ? "" : (current-volume > 50 ? "" : "")}))))




(defwidget widget-microphone []
  (eventbox
   :onhover "${EWW_CMD} update show-microphone=true"
   :onhoverlost "${EWW_CMD} update show-microphone=false"
   :onclick "${amixer} sset Capture toggle"
   (box
    :class "microphone status-item"
    :orientation "h"
    :space-evenly "false"
    :spacing "2"
    :tooltip "Capture : ${current-microphone}% [${current-microphone-state}]"
    (revealer :transition "slideleft" :reveal show-microphone
     (scale
          :class "scale"
          :value current-microphone
          :orientation "h"
          :flipped false
          :marks true
          :max 101
          :min 0
          :onchange "${amixer} sset Capture {}%"))
    (label
     :class "icon"
     :width 25 :height 20
     :xalign 0.5 :yalign 0.5
     :text { current-microphone-state == "off" ? "" : ""}))))
(defpoll current-volume           :initial 0 :interval "1s" "amixer sget Master  | grep '%' | awk -F'[][]' '{ print $2 }' | head -n 1 | tr -d '%'")
(defpoll current-volume-state     :initial 0 :interval "1s" "amixer sget Master  | grep '%' | awk -F'[][]' '{ print $4 }' | head -n 1")
(defpoll current-microphone       :initial 0 :interval "1s" "amixer sget Capture | grep '%' | awk -F'[][]' '{ print $2 }' | head -n 1 | tr -d '%'")
(defpoll current-microphone-state :initial 0 :interval "1s" "amixer sget Capture | grep '%' | awk -F'[][]' '{ print $4 }' | head -n 1")
(defvar show-memory false)
(defvar show-cpu false)
(defvar show-volume false)
(defvar show-microphone false)

(defwidget widget-cpu []
  (eventbox
   :onhover "${EWW_CMD} update show-cpu=true"
   :onhoverlost "${EWW_CMD} update show-cpu=false"
    (box
      :class "cpu status-item"
      :orientation "h"
      :space-evenly false
      (revealer :transition "slideleft" :reveal show-cpu
        (label
          :class "text"
          :xalign 0.5 :yalign 0.5
          :text " ${round(EWW_CPU.avg, 2)}% "))
      (circular-progress
          :class "progress"
          :width 22
          :height 25
          :thickness 4
          :tooltip " ${round(EWW_CPU.avg, 2)}%"
          :value {EWW_CPU.avg}))))
    
(defwidget widget-memory []
  (eventbox
   :onhover "${EWW_CMD} update show-memory=true"
   :onhoverlost "${EWW_CMD} update show-memory=false"
    (box
      :class "memory status-item"
      :space-evenly false
      :orientation "h"
      (revealer :transition "slideleft" :reveal show-memory
        (label
          :class "text"
          :xalign 0.5 :yalign 0.5
          :text " ${round(100 * EWW_RAM.used_mem / EWW_RAM.total_mem, 2)}% "))
      (circular-progress
          :class "progress"
          :width 22
          :height 20
          :thickness 4
          :tooltip " ${round(100 * EWW_RAM.used_mem / EWW_RAM.total_mem, 2)}%"
          :value {EWW_RAM.used_mem_perc}))))
  
(defwidget widget-tray []
  (systray
   :class "systray"
   :orientation "h"
   :space-evenly true
   :icon-size 25
   :prepend-new true))
  

(defwidget widget-clock []
  (box
   :class "clock status-item"
   :orientation "h"
   :halign "end"
   :space-evenly false
   :spacing 5
   :tooltip {formattime(EWW_TIME, "%F (%a) %T [%Z]")}
   ; (label :class "icon" :text "")
   (label :text "${clock.d}.${clock.m}.${clock.Y}")
   (label :class "icon" :text "")
   (label :text "${clock.H}:${clock.M}")))
  

(defpoll clock :initial "{}" :interval "10s"
  "date '+{\"H\":\"%H\", \"M\":\"%M\", \"d\":\"%d\", \"m\":\"%m\", \"b\":\"%b\", \"Y\":\"%Y\"}'")


; Calendar

(defwindow calendar
  :monitor 0
  :geometry (geometry :x "70px"
             :y "65%"
             :width "270px"
             :height "60px")
  (cal))


(defwidget cal []
  (box :class "cal"
   :orientation "v"
   (box :class "cal-inner-box"
    (calendar :class "cal"
       :day calendar_day
       :month calendar_month
       :year calendar_year))))
(defpoll calendar_day :interval "10h"
    "date '+%d'")
(defpoll calendar_month :interval "10h"
    "scripts/calendar")
(defpoll calendar_year :interval "10h"
    "date '+%Y'")

; Weather

(defwidget widget-weather [orientation]
  (box
   :class "weather status-item"
   :orientation orientation
   :space-evenly false
   :valign "start"
   :halign "center"
   :spacing 10
   (button :onclick "scripts/popup weather" "W")))
  

(defpoll weather-text :initial "" :interval "180s"
  "curl --max-time 2 wttr.in")

(defwindow weather
  :monitor 0
  :geometry (geometry :x "970px"
             :y "50%"
             :width "470px"
             :height "560px")
  (box :class "cal" "${ weather-text }"))

(defwidget temp-content [] (box (label :text "${ EWW_TEMPS }" :width 2080 :height 400 :truncate false :limit-width 10 :lines 10 :wrap true :wrap-mode "char")))


(defwindow temps
  :monitor 0
  :geometry (geometry) (temp-content))


